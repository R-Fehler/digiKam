[Desktop Entry]
Type=Application
Name=digiKam Photos
GenericName=Photo Library
Comment=Browse your photos with digiKam's streamlined Photos mode
Exec=digikam --photos %U
Icon=digikam
Terminal=false
Categories=Qt;KDE;Graphics;Photography;
